{
  // RangerTrak deploys as a Cloudflare Worker serving static assets, plus one
  // small piece of server code: a Range-request shim for the PMTiles basemap,
  // because Workers' asset store does not do byte serving. See DEPLOYING.md.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "worker/index.js",
  "name": "rangertrak",
  "compatibility_date": "2026-08-14",

  // Custom domains, declared here rather than clicked into the dashboard so the
  // hostname mapping is reviewable, reproducible and travels with the repo.
  // Cloudflare creates the proxied DNS records and provisions the certificate;
  // do NOT hand-create A/AAAA records for these names (see DEPLOYING.md).
  //
  // The apex ONLY. www.rangertrak.org was removed 2026-08-15 and must not come
  // back: it is a redirect-only hostname now, pointing at the apex via a Page
  // Rule, with its own proxied placeholder A record. A Worker Custom Domain
  // binds a hostname to the Worker ahead of Page Rules, so while www was listed
  // here the redirect silently never fired and www served the app directly -
  // giving two origins with two separate localStorage stores, which loses
  // mission data (DEPLOYING.md, "www vs apex").
  //
  // Re-adding www here would re-attach it on the next deploy and break the
  // redirect again, with no error and nothing failing.
  "routes": [
    { "pattern": "rangertrak.org", "custom_domain": true }
  ],

  "assets": {
    // @angular/build:application writes the browser bundle to dist/<project>/browser.
    "directory": "./dist/rangertrak/browser",

    // Angular is a SPA with `<base href="/">` and client-side routing, so any
    // path that isn't a real file must return index.html — otherwise a reload
    // or a deep link (/entry, /rangers) 404s. Pages guessed at this; Workers
    // requires it to be explicit.
    "not_found_handling": "single-page-application",

    // REQUIRED, and not cosmetic. The default ("auto-trailing-slash") answers a
    // request for /index.html with a 307 to /. The Angular service worker
    // prefetches /index.html, follows that redirect, and then calls cache.put()
    // — which the Cache API *refuses* for a redirected response (TypeError). The
    // install throws, ngsw caches nothing at all, and the app silently has no
    // offline capability and never notices new versions. Serving /index.html
    // directly is what makes the PWA a PWA.
    "html_handling": "none",

    // The Worker reaches the asset store through this binding.
    "binding": "ASSETS",

    // Everything except the basemap and the feedback API is served straight from the
    // asset store, untouched by the Worker. /api/feedback has no matching static file
    // (it would 404 from the asset store) - it needs to reach worker/index.js instead.
    "run_worker_first": ["/assets/maps/*", "/api/*"]
  },

  "observability": {
    "enabled": true
  }
}
