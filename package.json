{
  "name": "rangertrak",
  "version": "0.15.7",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "server": "node tools/serve-dist.js",
    "e2e": "node tools/e2e.js",
    "e2e:prod": "node tools/e2e.js --base=https://rangertrak.org --read-only",
    "check:secrets": "node tools/check-no-secrets.js",
    "deploy": "run-s build check:secrets deploy:only",
    "deploy:only": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "release": "standard-version",
    "compodoc": "npx compodoc -p tsconfig.doc.json --theme=Vagrant",
    "style": "import-sort -l \"**/{src,tests,e2e}/**/*.ts\" && prettier --check \"**/{src,tests,e2e}/**/*.{*css,ts}\"",
    "style:fix": "import-sort --write \"**/{src,tests,e2e}/**/*.ts\" && prettier --write \"**/{src,tests,e2e}/**/*.{*css,ts}\" && js-beautify \"**/src/**/*.html\"",
    "lint": "run-p lint:ts lint:tsc",
    "lint:fix": "run-s lint:ts:fix lint:tsc",
    "lint:ts": "tslint --config tslint.json --project . -e \"**/{test,polyfills}.ts\"",
    "lint:ts:fix": "tslint --config tslint.json --fix --project . -e \"**/{test,polyfills}.ts\"",
    "lint:tsc": "tsc --noEmit --skipLibCheck -p tsconfig.app.json && tsc --noEmit --skipLibCheck -p tsconfig.spec.json",
    "init:env": "init-dev-env generate-dot-env example.env -f"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.2",
    "@angular/cdk": "^22.1.2",
    "@angular/cli": "^22.1.4",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/material": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-browser-dynamic": "^22.1.2",
    "@angular/platform-server": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@angular/service-worker": "^22.1.2",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@material/banner": "^14.0.0",
    "@material/icon-button": "^14.0.0",
    "@material/slider": "^14.0.0",
    "@material/switch": "^14.0.0",
    "@material/top-app-bar": "^14.0.0",
    "@mdi/js": "^7.4.47",
    "@types/core-js": "^2.5.8",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@what3words/api": "^5.4.0",
    "ag-grid-angular": "^35.0.0",
    "ag-grid-community": "^35.0.0",
    "ajv": "^8.17.1",
    "crypto-js": "^4.2.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "leaflet.offline": "^3.2.0",
    "maplibre-gl": "^6.3.0",
    "mock-browser": "^0.92.14",
    "pmtiles": "^4.5.0",
    "tslib": "^2.8.1",
    "xlsx": "^0.18.5",
    "xlsx-style": "^0.8.13",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@types/google.maps": "^3.58.1",
    "@types/jasmine": "^5.1.13",
    "@types/node": "^25.0.3",
    "acorn": "^8.15.0",
    "cross-conf-env": "^1.3.0",
    "dev-norms": "^2.0.4",
    "http-server": "^14.1.1",
    "import-sort": "^6.0.0",
    "import-sort-cli": "^6.0.0",
    "import-sort-parser-typescript": "^6.0.0",
    "import-sort-style-module": "^6.0.0",
    "init-dev-env": "^2.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.13.0",
    "js-beautify": "^1.15.4",
    "jshint": "^2.13.6",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.2",
    "rxjs": "^7.8.2",
    "tsviz-cli": "^2.0.3",
    "typescript": "^6.0.3",
    "wrangler": "4.119.0"
  },
  "importSort": {
    ".ts, .tsx": {
      "parser": "typescript",
      "style": "module",
      "options": {}
    }
  }
}
